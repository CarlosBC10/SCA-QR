/*
 * SCA-QR — Design System / UI Foundation
 * Visual layer only. No application logic.
 */
:root {
    --sca-primary: #2e7d32;
    --sca-primary-dark: #1b5e20;
    --sca-primary-soft: rgba(46, 125, 50, .09);
    --sca-secondary: #f57c00;
    --sca-bg: #f4f6f8;
    --sca-card-bg: #ffffff;
    --sca-sidebar-bg: rgba(255, 255, 255, .92);
    --sca-topbar-bg: rgba(255, 255, 255, .88);
    --sca-text: #1e2933;
    --sca-text-muted: #687481;
    --sca-border: rgba(15, 23, 42, .085);
    --sca-border-strong: rgba(15, 23, 42, .14);
    --sca-hover: rgba(46, 125, 50, .055);
    --sca-input-bg: #ffffff;
    --sca-input-border: #d9e0e7;
    --sca-shadow-xs: 0 1px 2px rgba(15, 23, 42, .04);
    --sca-shadow-sm: 0 5px 18px rgba(15, 23, 42, .06);
    --sca-shadow-md: 0 12px 34px rgba(15, 23, 42, .09);
    --sca-radius-sm: 10px;
    --sca-radius-md: 14px;
    --sca-radius-lg: 18px;
    --sca-sidebar-width: 272px;
    --sca-topbar-height: 70px;
}

[data-bs-theme="dark"] {
    --sca-bg: #0d1117;
    --sca-card-bg: #151b23;
    --sca-sidebar-bg: rgba(21, 27, 35, .94);
    --sca-topbar-bg: rgba(21, 27, 35, .90);
    --sca-text: #e6edf3;
    --sca-text-muted: #9aa7b4;
    --sca-border: rgba(255, 255, 255, .08);
    --sca-border-strong: rgba(255, 255, 255, .13);
    --sca-hover: rgba(102, 187, 106, .10);
    --sca-input-bg: #1b2330;
    --sca-input-border: #344052;
    --sca-shadow-xs: 0 1px 2px rgba(0, 0, 0, .20);
    --sca-shadow-sm: 0 5px 18px rgba(0, 0, 0, .18);
    --sca-shadow-md: 0 12px 34px rgba(0, 0, 0, .26);
    color-scheme: dark;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(circle at 100% 0%, rgba(46, 125, 50, .035), transparent 28rem),
        var(--sca-bg);
    color: var(--sca-text);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
}

body.sca-sidebar-open {
    overflow: hidden;
}

::selection {
    background: rgba(46, 125, 50, .18);
    color: var(--sca-text);
}

:focus-visible {
    outline: 3px solid rgba(46, 125, 50, .26);
    outline-offset: 2px;
}

a {
    text-underline-offset: 3px;
}

button,
.btn,
.form-control,
.form-select {
    -webkit-tap-highlight-color: transparent;
}

.sidebar {
    width: var(--sca-sidebar-width);
    box-shadow: 10px 0 34px rgba(15, 23, 42, .07);
}

.sidebar::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255,255,255,.12), transparent 18%);
}

.sidebar-header {
    min-height: var(--sca-topbar-height);
    padding: 1rem 1.15rem;
    position: relative;
    z-index: 1;
}

.sidebar-logo-img {
    max-height: 40px;
}

.sidebar-nav {
    position: relative;
    z-index: 1;
    scrollbar-width: thin;
    scrollbar-color: rgba(108,117,125,.35) transparent;
}

.nav-section-title {
    margin-top: 1.35rem;
    font-size: .68rem;
    letter-spacing: .1em;
}

.sidebar-nav .nav-link {
    min-height: 44px;
    border: 1px solid transparent;
    position: relative;
    overflow: hidden;
}

.sidebar-nav .nav-link:hover {
    transform: translateX(2px);
}

.sidebar-nav .nav-link.active {
    font-weight: 650;
    box-shadow: 0 7px 18px rgba(46, 125, 50, .18);
}

.sidebar-nav .nav-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: rgba(255,255,255,.95);
}

.sidebar-nav .nav-link[data-bs-toggle="collapse"].active {
    background: var(--sca-hover);
    color: var(--sca-primary);
    box-shadow: none;
}

.sidebar-nav .nav-link[data-bs-toggle="collapse"].active::before {
    background: var(--sca-primary);
}

.sca-chevron { font-size: .78rem; transition: transform .2s ease; }

.sidebar-nav .nav-link .bi {
    flex: 0 0 1.15rem;
    width: 1.15rem;
    text-align: center;
}

#submenuSolicitudes {
    padding-left: .55rem !important;
    margin-bottom: .3rem;
    border-left: 1px solid var(--sca-border);
}

#submenuSolicitudes .nav-link {
    min-height: 39px;
    font-size: .83rem;
    padding-top: .56rem;
    padding-bottom: .56rem;
    padding-left: .9rem;
    margin-bottom: .1rem;
}

#submenuSolicitudes .nav-link.active {
    background: var(--sca-hover);
    color: var(--sca-primary);
    font-weight: 650;
}

#submenuSolicitudes .nav-link.active::before {
    background: var(--sca-primary);
}

.sidebar-footer {
    position: relative;
    z-index: 1;
    padding: .9rem 1rem;
}

.main-content {
    margin-left: var(--sca-sidebar-width);
}

.topbar {
    min-height: var(--sca-topbar-height);
    height: var(--sca-topbar-height);
    padding: 0 1.5rem;
    box-shadow: 0 1px 0 var(--sca-border), 0 6px 24px rgba(15, 23, 42, .035);
}

.content-wrapper {
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding: 1.65rem 1.75rem 2.4rem;
}

.card,
.sca-card {
    border-color: var(--sca-border);
    border-radius: var(--sca-radius-lg);
    box-shadow: var(--sca-shadow-sm);
}

.card:hover {
    border-color: var(--sca-border-strong);
}

.card-header {
    padding: 1rem 1.25rem;
}

.card-footer {
    border-color: var(--sca-border) !important;
}

.btn {
    min-height: 40px;
    border-radius: var(--sca-radius-sm);
    font-weight: 600;
    letter-spacing: -.01em;
}

.btn-sm {
    min-height: 34px;
}

.btn-lg {
    min-height: 48px;
    border-radius: 12px;
}

.btn-success,
.btn-primary {
    box-shadow: 0 6px 16px rgba(46, 125, 50, .16);
}

.btn-success:hover,
.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 9px 20px rgba(46, 125, 50, .22);
}

.form-label {
    color: var(--sca-text);
    font-weight: 600;
}

.form-control,
.form-select {
    min-height: 42px;
    border-radius: var(--sca-radius-sm);
    border-color: var(--sca-input-border);
    background-color: var(--sca-input-bg);
}

.form-control:focus,
.form-select:focus {
    border-color: var(--sca-primary);
    box-shadow: 0 0 0 .22rem rgba(46, 125, 50, .13);
}

.input-group-text {
    border-color: var(--sca-input-border);
    background: var(--sca-card-bg);
    background: color-mix(in srgb, var(--sca-card-bg) 88%, var(--sca-hover));
    color: var(--sca-text-muted);
}

.table {
    --bs-table-border-color: var(--sca-border);
    margin-bottom: 0;
}

.table thead th {
    color: var(--sca-text-muted);
    font-size: .73rem;
    font-weight: 700;
    letter-spacing: .045em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--sca-card-bg);
    background: color-mix(in srgb, var(--sca-card-bg) 92%, var(--sca-hover));
    border-bottom-width: 1px;
}

.table > :not(caption) > * > * {
    padding-top: .85rem;
    padding-bottom: .85rem;
}

.table-hover > tbody > tr:hover > * {
    --bs-table-accent-bg: var(--sca-hover);
    color: var(--sca-text);
}

.badge {
    letter-spacing: .01em;
    font-weight: 650;
}

.alert {
    border-radius: var(--sca-radius-md);
}

.dropdown-menu,
.modal-content,
.toast {
    border-color: var(--sca-border);
    border-radius: 14px;
    box-shadow: var(--sca-shadow-md);
}

.dropdown-menu {
    padding: .4rem;
}

.dropdown-item {
    border-radius: 9px;
    padding: .55rem .7rem;
}

.dropdown-item:hover,
.dropdown-item:focus {
    background: var(--sca-hover);
}

.modal-content {
    overflow: hidden;
}

.modal-header,
.modal-footer {
    padding-left: 1.35rem;
    padding-right: 1.35rem;
}

.theme-toggle {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border-color: var(--sca-border-strong);
}

.theme-toggle:hover {
    transform: translateY(-1px);
}

.sidebar-toggle {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    background: var(--sca-hover);
    border: 1px solid var(--sca-border);
}

.sca-mobile-overlay {
    display: none;
}

.sca-user-meta {
    min-width: 0;
    max-width: 260px;
}

.sca-user-name {
    font-size: .88rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sca-user-detail {
    margin-top: .15rem;
    font-size: .71rem;
    color: var(--sca-text-muted);
    white-space: nowrap;
}

.sca-role-badge {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    margin-top: .2rem;
    padding: .22rem .5rem;
    border-radius: 999px;
    background: var(--sca-hover);
    color: var(--sca-primary);
    font-weight: 700;
}

.sca-page-title {
    letter-spacing: -.025em;
}

.sca-page-subtitle {
    max-width: 72ch;
}

.sca-stat-card {
    position: relative;
    overflow: hidden;
}

.sca-stat-card::after {
    content: "";
    position: absolute;
    width: 90px;
    height: 90px;
    right: -28px;
    top: -32px;
    border-radius: 50%;
    background: var(--sca-primary-soft);
    pointer-events: none;
}

.sca-empty {
    padding: 3rem 1.5rem;
    text-align: center;
}

.sca-empty .bi {
    font-size: 2.35rem;
    opacity: .45;
}

.sca-table-shell {
    overflow: hidden;
}

.sca-table-actions {
    white-space: nowrap;
}

.sca-scroll-y {
    scrollbar-width: thin;
    scrollbar-color: rgba(108,117,125,.28) transparent;
}

.sca-kicker {
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--sca-primary);
}

.sca-divider {
    height: 1px;
    background: var(--sca-border);
    border: 0;
    margin: 1rem 0;
}

@media (max-width: 1200px) {
    :root {
        --sca-sidebar-width: 248px;
    }

    .content-wrapper {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
    }

    .sca-user-meta {
        max-width: 190px;
    }
}

@media (max-width: 992px) {
    .sidebar {
        width: min(86vw, 300px);
        box-shadow: 16px 0 40px rgba(15, 23, 42, .16);
    }

    .main-content {
        margin-left: 0;
    }

    .topbar {
        padding: 0 1rem;
    }

    .content-wrapper {
        padding: 1.15rem .95rem 1.8rem;
    }

    .sca-mobile-overlay {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .45);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        opacity: 0;
        pointer-events: none;
        transition: opacity .22s ease;
        z-index: 999;
    }

    .sca-mobile-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }
}

@media (max-width: 767px) {
    .topbar {
        gap: .5rem;
    }

    .topbar .d-flex.align-items-center.gap-3 {
        gap: .45rem !important;
    }

    .sca-user-meta {
        display: none;
    }

    .content-wrapper {
        padding-top: 1rem;
    }

    .card,
    .sca-card {
        border-radius: 15px;
    }

    .table-responsive {
        border-radius: 13px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}


.sca-warning-alert {
    background: rgba(255, 193, 7, .10);
    color: #735d00;
    border: 1px solid rgba(255, 193, 7, .22);
}

[data-bs-theme="dark"] .sca-warning-alert {
    background: rgba(255, 193, 7, .12);
    color: #ffdb6d;
    border-color: rgba(255, 193, 7, .22);
}


/* ================================================================
   SCA-QR PRO UI — Navigation & visual system v2
   Only presentation rules. No route, permission or business logic.
   ================================================================ */
:root {
    --sca-sidebar-w: 286px;
    --sca-radius-sm: 10px;
    --sca-radius-md: 14px;
    --sca-radius-lg: 20px;
    --sca-ease: cubic-bezier(.22,1,.36,1);
    --sca-primary-rgb: 46,125,50;
    --sca-orange: #ef7d00;
    --sca-surface: #ffffff;
    --sca-surface-2: #f7f9f8;
    --sca-sidebar-bg-pro: #0c1711;
    --sca-sidebar-2: #122019;
    --sca-text-strong: #142019;
    --sca-shadow-pro: 0 12px 35px rgba(20,32,25,.07);
}
[data-bs-theme="dark"] {
    --sca-surface: #151d19;
    --sca-surface-2: #1a241f;
    --sca-text-strong: #eef4f0;
    --sca-shadow-pro: 0 16px 40px rgba(0,0,0,.25);
    --sca-sidebar-bg-pro: #09100c;
    --sca-sidebar-2: #0e1812;
}

html { scroll-behavior: smooth; }
body { background: radial-gradient(circle at 90% -10%, rgba(46,125,50,.07), transparent 30%), var(--sca-bg); }
body.sca-sidebar-open { overflow: hidden; }

/* Sidebar */
.sidebar {
    width: var(--sca-sidebar-w);
    background: linear-gradient(180deg, var(--sca-sidebar-bg-pro) 0%, var(--sca-sidebar-2) 100%);
    border-right: 1px solid rgba(255,255,255,.06);
    box-shadow: 10px 0 40px rgba(9,18,12,.16);
    overflow: hidden;
}
.sidebar-brand {
    padding: 22px 18px 17px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    position: relative;
}
.sidebar-brand-link { display:flex; align-items:center; min-height:50px; text-decoration:none; color:#fff; gap:12px; }
.sidebar-logo-img { max-width: 190px; height: 46px; object-fit: contain; object-position:left center; filter: drop-shadow(0 5px 12px rgba(0,0,0,.22)); }
.sidebar-logo-fallback { width:46px; height:46px; flex:0 0 46px; border-radius:15px; display:grid; place-items:center; font-weight:800; background:linear-gradient(135deg,#4caf50,#1b5e20); color:white; box-shadow:0 8px 18px rgba(46,125,50,.28); }
.sidebar-brand-copy { display:flex; flex-direction:column; line-height:1.1; }
.sidebar-brand-copy strong { font-size:1.04rem; letter-spacing:.01em; }
.sidebar-brand-copy small { margin-top:5px; font-size:.69rem; color:rgba(255,255,255,.58); }
.sidebar-brand-badge { display:inline-flex; align-items:center; gap:7px; margin-top:12px; padding:6px 9px; border:1px solid rgba(255,255,255,.08); border-radius:999px; color:rgba(255,255,255,.66); font-size:.63rem; font-weight:700; letter-spacing:.11em; text-transform:uppercase; }
.sidebar-brand-badge i { color:#7dd77f; }
.sidebar-nav { padding:14px 12px 12px; }
.nav-section-title { display:flex; align-items:center; margin:18px 8px 8px; color:rgba(255,255,255,.36); font-size:.64rem; text-transform:uppercase; letter-spacing:.14em; font-weight:800; }
.nav-section-title:first-child { margin-top:4px; }
.sidebar-nav .nav-link { position:relative; color:rgba(255,255,255,.68); padding:10px 11px; min-height:46px; border-radius:12px; margin:3px 0; display:flex; align-items:center; gap:10px; font-size:.86rem; font-weight:600; text-decoration:none; transition:background .2s var(--sca-ease), color .2s var(--sca-ease), transform .2s var(--sca-ease); }
.sidebar-nav .nav-link:hover { background:rgba(255,255,255,.055); color:#fff; transform:translateX(2px); }
.sidebar-nav .nav-link.active { color:#fff; background:linear-gradient(90deg, rgba(76,175,80,.22), rgba(76,175,80,.07)); box-shadow: inset 0 0 0 1px rgba(124,211,126,.08); }
.sidebar-nav .nav-link.active::before { content:""; position:absolute; left:-12px; top:9px; bottom:9px; width:3px; border-radius:0 4px 4px 0; background:#72d273; box-shadow:0 0 14px rgba(114,210,115,.45); }
.nav-main { min-width:0; display:flex; align-items:center; gap:10px; }
.nav-icon { width:26px; min-width:26px; height:26px; display:grid; place-items:center; color:rgba(255,255,255,.52); font-size:1rem; }
.nav-link.active .nav-icon, .nav-link:hover .nav-icon { color:#7ddd80; }
.nav-label { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.nav-chevron { margin-left:auto; font-size:.7rem; opacity:.55; transition:transform .2s ease; }
.nav-parent[aria-expanded="true"] .nav-chevron { transform:rotate(180deg); }
.nav-submenu { margin:1px 0 4px 19px; padding-left:9px; border-left:1px solid rgba(255,255,255,.08); }
.nav-submenu .nav-link { min-height:40px; padding:8px 10px; font-size:.82rem; color:rgba(255,255,255,.57); }
.nav-submenu .nav-link.active { background:rgba(255,255,255,.05); box-shadow:none; }
.nav-submenu .nav-link.active::before { display:none; }
.nav-submenu .nav-icon { width:21px; min-width:21px; font-size:.85rem; }
.nav-link.disabled { opacity:.45; cursor:not-allowed; }
.nav-link.disabled:hover { transform:none; background:transparent; }
.nav-soon { margin-left:auto; padding:3px 6px; border-radius:999px; border:1px solid rgba(255,255,255,.09); font-size:.56rem; letter-spacing:.03em; }
.sidebar-bottom { padding:10px 14px 14px; border-top:1px solid rgba(255,255,255,.07); background:rgba(0,0,0,.08); }
.sidebar-status { display:flex; align-items:center; gap:8px; padding:8px 9px; border-radius:10px; margin-bottom:9px; background:rgba(255,255,255,.035); color:rgba(255,255,255,.55); font-size:.68rem; font-weight:600; }
.status-dot { width:7px; height:7px; border-radius:50%; background:#69d06b; box-shadow:0 0 0 4px rgba(105,208,107,.10), 0 0 10px rgba(105,208,107,.55); }
.sidebar-footer { display:grid; grid-template-columns:1fr auto; gap:2px 8px; padding:0 3px; color:rgba(255,255,255,.36); font-size:.62rem; }
.sidebar-footer span:first-child { font-weight:700; color:rgba(255,255,255,.53); }
.sidebar-footer small { grid-column:1/-1; font-size:.58rem; }

/* topbar */
.main-content { margin-left:var(--sca-sidebar-w); }
.topbar { height:74px; padding:0 24px; background:rgba(255,255,255,.88); border-bottom:1px solid rgba(20,32,25,.07); box-shadow:0 5px 22px rgba(20,32,25,.045); }
[data-bs-theme="dark"] .topbar { background:rgba(16,24,20,.9); border-bottom-color:rgba(255,255,255,.07); }
.topbar-left,.topbar-tools { display:flex; align-items:center; }
.topbar-left { gap:14px; }
.topbar-context { align-items:center; gap:10px; }
.topbar-context-icon { width:36px; height:36px; display:grid; place-items:center; border-radius:11px; color:var(--sca-primary); background:rgba(var(--sca-primary-rgb),.09); }
.topbar-context strong,.topbar-context span { display:block; line-height:1.08; }
.topbar-context strong { color:var(--sca-text-strong); font-size:.76rem; letter-spacing:.04em; }
.topbar-context span { color:var(--sca-text-muted); font-size:.64rem; margin-top:4px; }
.topbar-tools { gap:9px; }
.topbar-tools > * { flex-shrink:0; }
.topbar-clock { padding:0 7px; }
.theme-toggle { width:40px; height:40px; border-radius:12px; border:1px solid var(--sca-border); background:var(--sca-surface); box-shadow:none; }
.theme-toggle:hover { background:rgba(var(--sca-primary-rgb),.08); }
.theme-toggle .bi-sun-fill { display:none; color:#e0a300; }
.theme-toggle .bi-moon-stars-fill { display:block; color:var(--sca-text-muted); }
[data-bs-theme="dark"] .theme-toggle .bi-sun-fill { display:block; }
[data-bs-theme="dark"] .theme-toggle .bi-moon-stars-fill { display:none; }
.sidebar-toggle { width:42px; height:42px; display:none; place-items:center; border:1px solid var(--sca-border); border-radius:12px; background:var(--sca-surface); color:var(--sca-text); }
.user-menu { display:flex; align-items:center; gap:10px; padding-left:9px; border-left:1px solid var(--sca-border); }
.user-avatar { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; color:#fff; font-size:.78rem; font-weight:800; background:linear-gradient(135deg,var(--sca-primary),var(--sca-primary-dark)); box-shadow:0 5px 14px rgba(46,125,50,.22); }
.user-copy strong,.user-copy span { display:block; line-height:1.15; }
.user-copy strong { max-width:190px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--sca-text-strong); font-size:.73rem; }
.user-copy > span { margin-top:4px; color:var(--sca-text-muted); font-size:.61rem; }
.user-role { display:inline-block!important; padding:3px 6px; margin-right:5px; border-radius:999px; color:var(--sca-primary); background:rgba(var(--sca-primary-rgb),.08); font-weight:700; }
.user-divider { margin-right:5px; color:var(--sca-border); }
.logout-button { width:38px; height:38px; display:grid; place-items:center; border-radius:11px; color:#b64c4c; border:1px solid rgba(220,53,69,.16); background:rgba(220,53,69,.045); text-decoration:none; transition:.2s var(--sca-ease); }
.logout-button:hover { color:#fff; background:#c94c4c; border-color:#c94c4c; transform:translateY(-1px); }

/* content / pages */
.content-wrapper { padding:26px clamp(18px, 2.4vw, 36px) 34px; }
.sca-page-head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; }
.sca-page-eyebrow { display:inline-flex; align-items:center; gap:7px; margin-bottom:7px; color:var(--sca-primary); font-size:.65rem; font-weight:800; text-transform:uppercase; letter-spacing:.14em; }
.sca-page-eyebrow::before { content:""; width:18px; height:2px; border-radius:2px; background:var(--sca-secondary); }
.sca-page-title { margin:0; color:var(--sca-text-strong); font-size:clamp(1.35rem,2vw,1.75rem); font-weight:750; letter-spacing:-.025em; }
.sca-page-subtitle { margin:6px 0 0; color:var(--sca-text-muted); font-size:.82rem; }
.sca-kpi-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:15px; }
.sca-kpi-card { position:relative; overflow:hidden; padding:18px; border:1px solid var(--sca-border); border-radius:16px; background:var(--sca-surface); box-shadow:var(--sca-shadow-pro); }
.sca-kpi-card::after { content:""; position:absolute; width:90px; height:90px; right:-28px; top:-28px; border-radius:50%; background:rgba(var(--sca-primary-rgb),.05); }
.sca-kpi-label { color:var(--sca-text-muted); font-size:.64rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
.sca-kpi-value { color:var(--sca-text-strong); margin-top:7px; font-size:1.8rem; line-height:1; font-weight:800; letter-spacing:-.04em; }
.sca-kpi-note { margin-top:9px; color:var(--sca-text-muted); font-size:.66rem; }

/* normalize legacy inline-heavy dashboard cards without changing their contents */
.content-wrapper .card { border-radius:16px; box-shadow:var(--sca-shadow-pro); border-color:var(--sca-border); }
.content-wrapper .card-hover:hover { transform:translateY(-3px); box-shadow:0 18px 38px rgba(20,32,25,.10)!important; }
.content-wrapper .card-header { padding:16px 18px; }
.content-wrapper .btn { min-height:40px; }
.content-wrapper h1,.content-wrapper h2,.content-wrapper h3,.content-wrapper h4,.content-wrapper h5,.content-wrapper h6 { color:var(--sca-text-strong); }
.content-wrapper .text-dark { color:var(--sca-text-strong)!important; }
.content-wrapper .bg-light { background:var(--sca-surface-2)!important; }

/* mobile */
.sca-mobile-overlay { position:fixed; inset:0; background:rgba(3,10,6,.48); backdrop-filter:blur(2px); z-index:999; opacity:0; visibility:hidden; transition:.25s ease; }
.sca-mobile-overlay.show { opacity:1; visibility:visible; }
@media (max-width: 1180px) {
  :root { --sca-sidebar-w:260px; }
  .sidebar { width:var(--sca-sidebar-w); }
  .main-content { margin-left:var(--sca-sidebar-w); }
  .topbar { padding:0 18px; }
  .sca-kpi-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width: 992px) {
  .sidebar { transform:translateX(-100%); width:min(86vw,300px); box-shadow:18px 0 50px rgba(0,0,0,.22); }
  .sidebar.show { transform:translateX(0); }
  .main-content { margin-left:0; }
  .sidebar-toggle { display:grid; }
  .content-wrapper { padding:22px 17px 28px; }
}
@media (max-width: 767px) {
  .topbar { height:66px; padding:0 12px; }
  .topbar-tools { gap:6px; }
  .user-menu { padding-left:5px; border-left:0; }
  .logout-button { width:36px; height:36px; }
  .user-avatar { width:36px; height:36px; }
  .sca-page-head { align-items:flex-start; margin-bottom:18px; }
  .sca-page-title { font-size:1.32rem; }
  .sca-kpi-grid { grid-template-columns:1fr 1fr; gap:10px; }
  .sca-kpi-card { padding:14px; }
  .sca-kpi-value { font-size:1.45rem; }
}
@media (max-width: 430px) {
  .sca-kpi-grid { grid-template-columns:1fr; }
  .sidebar-toggle { width:38px; height:38px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior:auto!important; animation-duration:.001ms!important; animation-iteration-count:1!important; transition-duration:.001ms!important; }
}

.sca-page-chip{align-items:center;gap:7px;padding:8px 11px;border:1px solid var(--sca-border);border-radius:999px;color:var(--sca-text-muted);background:var(--sca-surface);font-size:.68rem;font-weight:700;box-shadow:0 4px 14px rgba(20,32,25,.04)}
.sca-page-chip i{color:var(--sca-primary)}


/* =====================================================================
   SCA-QR FRONT PRO V3 — Experience layer
   Presentation only. Do not add business logic here.
   ===================================================================== */
:root {
    --sca-surface: #ffffff;
    --sca-surface-2: #f7f9f8;
    --sca-surface-3: #eef3ef;
    --sca-text-strong: #142019;
    --sca-text-muted: #68766e;
    --sca-line: rgba(20,32,25,.08);
    --sca-line-strong: rgba(20,32,25,.14);
    --sca-green: #2e7d32;
    --sca-green-dark: #1b5e20;
    --sca-orange: #ef7d00;
    --sca-info: #1976a8;
    --sca-danger: #c94c4c;
    --sca-radius-xl: 22px;
    --sca-radius-lg: 17px;
    --sca-radius-md: 13px;
    --sca-ease: cubic-bezier(.22,1,.36,1);
}
[data-bs-theme="dark"] {
    --sca-surface: #151d19;
    --sca-surface-2: #1b2520;
    --sca-surface-3: #202c25;
    --sca-text-strong: #f0f6f2;
    --sca-text-muted: #9baaa1;
    --sca-line: rgba(255,255,255,.08);
    --sca-line-strong: rgba(255,255,255,.13);
}

/* Page hierarchy */
.sca-dashboard-head { margin-bottom: 18px; }
.sca-dashboard-head .sca-page-title { font-size: clamp(1.5rem,2.25vw,2rem); }
.sca-page-head.legacy-page-head { margin-bottom: 20px; }
.sca-page-head.legacy-page-head .sca-page-subtitle { max-width: 780px; }
.sca-section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin: 0 0 13px; }
.sca-section-heading h2 { margin: 2px 0 0; font-size: 1rem; color: var(--sca-text-strong); font-weight: 750; letter-spacing: -.015em; }
.sca-kicker { color: var(--sca-green); font-size:.64rem; font-weight:800; text-transform:uppercase; letter-spacing:.13em; }

/* Executive KPI cards */
.sca-kpi-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
.sca-kpi-card { position:relative; min-width:0; overflow:hidden; padding:18px; border:1px solid var(--sca-line); border-radius:18px; background:var(--sca-surface); box-shadow:0 9px 28px rgba(20,32,25,.055); transition:transform .22s var(--sca-ease), box-shadow .22s var(--sca-ease), border-color .22s ease; }
.sca-kpi-card:hover { transform:translateY(-2px); box-shadow:0 16px 34px rgba(20,32,25,.09); border-color:var(--sca-line-strong); }
.sca-kpi-top { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.sca-kpi-label { color:var(--sca-text-muted); font-size:.65rem; font-weight:800; letter-spacing:.065em; text-transform:uppercase; line-height:1.25; }
.sca-kpi-icon { width:38px; height:38px; flex:0 0 38px; display:grid; place-items:center; border-radius:11px; background:rgba(46,125,50,.1); color:var(--sca-green); }
.sca-kpi-icon.is-orange { background:rgba(239,125,0,.11); color:var(--sca-orange); }
.sca-kpi-icon.is-blue { background:rgba(25,118,168,.1); color:var(--sca-info); }
.sca-kpi-icon.is-red { background:rgba(201,76,76,.1); color:var(--sca-danger); }
.sca-kpi-value { margin-top:12px; color:var(--sca-text-strong); font-size:clamp(1.6rem,2.6vw,2.1rem); line-height:1; font-weight:800; letter-spacing:-.04em; }
.sca-kpi-note { margin-top:9px; color:var(--sca-text-muted); font-size:.68rem; line-height:1.35; }

/* Focus / action pattern */
.sca-focus-card { display:flex; align-items:center; gap:15px; min-height:128px; padding:20px; border:1px solid var(--sca-line); border-radius:20px; background:var(--sca-surface); box-shadow:0 10px 30px rgba(20,32,25,.06); }
.sca-focus-card.has-alert { border-color:rgba(239,125,0,.22); background:linear-gradient(135deg, rgba(239,125,0,.065), var(--sca-surface) 48%); }
.sca-focus-card.is-clear { background:linear-gradient(135deg, rgba(46,125,50,.065), var(--sca-surface) 48%); }
.sca-focus-icon { width:50px; height:50px; flex:0 0 50px; display:grid; place-items:center; border-radius:15px; color:var(--sca-green); background:rgba(46,125,50,.1); font-size:1.15rem; }
.sca-focus-card.has-alert .sca-focus-icon { color:var(--sca-orange); background:rgba(239,125,0,.12); }
.sca-focus-copy { min-width:0; }
.sca-focus-copy .sca-kicker { display:block; margin-bottom:4px; }
.sca-focus-copy strong { display:block; color:var(--sca-text-strong); font-size:clamp(1.45rem,2.4vw,2rem); line-height:1; font-weight:850; }
.sca-focus-copy p { margin:6px 0 0; color:var(--sca-text-muted); font-size:.74rem; }

.sca-action-card { position:relative; display:flex; align-items:center; gap:13px; min-height:112px; padding:18px 19px; border:1px solid var(--sca-line); border-radius:18px; background:var(--sca-surface); box-shadow:0 8px 24px rgba(20,32,25,.05); color:var(--sca-text-strong); overflow:hidden; transition:transform .22s var(--sca-ease), box-shadow .22s var(--sca-ease), border-color .22s ease; }
.sca-action-card:hover { transform:translateY(-3px); box-shadow:0 17px 36px rgba(20,32,25,.09); border-color:rgba(46,125,50,.22); color:var(--sca-text-strong); }
.sca-action-card-primary { background:linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%); border-color:transparent; color:#fff; box-shadow:0 12px 28px rgba(46,125,50,.2); }
.sca-action-card-primary:hover { color:#fff; box-shadow:0 18px 36px rgba(46,125,50,.28); }
.sca-action-icon { width:44px; height:44px; flex:0 0 44px; display:grid; place-items:center; border-radius:13px; background:rgba(255,255,255,.16); font-size:1.05rem; }
.sca-action-card:not(.sca-action-card-primary) .sca-action-icon { color:var(--sca-green); background:rgba(46,125,50,.09); }
.sca-action-icon-info { color:var(--sca-info)!important; background:rgba(25,118,168,.09)!important; }
.sca-action-copy { display:flex; min-width:0; flex-direction:column; gap:4px; }
.sca-action-copy strong { font-size:.92rem; font-weight:750; }
.sca-action-copy small { color:rgba(255,255,255,.78); font-size:.69rem; line-height:1.35; }
.sca-action-card:not(.sca-action-card-primary) .sca-action-copy small { color:var(--sca-text-muted); }
.sca-action-arrow { margin-left:auto; opacity:.75; transition:transform .2s var(--sca-ease); }
.sca-action-card:hover .sca-action-arrow { transform:translate(2px,-2px); opacity:1; }

.sca-info-strip { display:flex; align-items:center; gap:12px; padding:13px 15px; border:1px solid var(--sca-line); border-radius:15px; background:var(--sca-surface-2); color:var(--sca-text-muted); }
.sca-info-strip-icon { width:34px; height:34px; flex:0 0 34px; display:grid; place-items:center; border-radius:10px; background:rgba(46,125,50,.1); color:var(--sca-green); }
.sca-info-strip strong,.sca-info-strip span { display:block; }
.sca-info-strip strong { color:var(--sca-text-strong); font-size:.76rem; }
.sca-info-strip span { margin-top:2px; font-size:.67rem; line-height:1.35; }

/* Alert panel */
.sca-alert-panel { display:flex; flex-direction:column; padding:19px; border:1px solid var(--sca-line); border-radius:19px; background:var(--sca-surface); box-shadow:0 9px 28px rgba(20,32,25,.055); }
.sca-alert-panel.has-warning { background:linear-gradient(135deg,rgba(245,158,11,.09),var(--sca-surface) 55%); border-color:rgba(245,158,11,.22); }
.sca-alert-panel.is-clear { background:linear-gradient(135deg,rgba(46,125,50,.065),var(--sca-surface) 55%); }
.sca-alert-panel-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
.sca-alert-panel-head > i { color:var(--sca-green); font-size:1rem; }
.sca-alert-panel.has-warning .sca-alert-panel-head > i { color:#b87900; }
.sca-alert-panel strong { color:var(--sca-text-strong); font-size:1rem; font-weight:800; line-height:1.25; }
.sca-alert-panel p { margin:7px 0 18px; color:var(--sca-text-muted); font-size:.72rem; line-height:1.5; }
.sca-alert-panel .btn { align-self:flex-start; margin-top:auto; }

/* Consistent filters / toolbars */
.content-wrapper > form.card,
.content-wrapper > .card:has(> .table-responsive),
.sca-filter-card { border-radius:17px!important; border:1px solid var(--sca-line)!important; box-shadow:0 8px 24px rgba(20,32,25,.045)!important; }
.content-wrapper form.card .card-body { padding:17px; }
.content-wrapper .form-label { font-size:.72rem; letter-spacing:.01em; }
.content-wrapper .btn-outline-success { border-color:rgba(46,125,50,.4); }

/* Tables as product surfaces */
.sca-table-shell, .table-responsive { border-radius:16px; }
.table { font-size:.77rem; }
.table thead th { padding-top:.82rem!important; padding-bottom:.82rem!important; }
.table tbody td { vertical-align:middle; }
.table tbody tr { transition:background .16s ease; }
.table .btn-sm { min-width:34px; padding:.32rem .5rem; }

/* Badges as status, not decoration */
.badge { border:1px solid transparent; }
.badge.rounded-pill { padding:.42em .7em; }

/* Forms */
.content-wrapper .card .card-body { color:var(--sca-text); }
.form-control, .form-select { box-shadow:0 1px 2px rgba(20,32,25,.025); }
.form-control:hover, .form-select:hover { border-color:var(--sca-line-strong); }
.form-check-label { font-size:.8rem; }

/* Search/filter mobile actions */
@media (max-width: 992px) {
    .sca-kpi-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .sca-focus-card { min-height:116px; }
}
@media (max-width: 767px) {
    .sca-page-head { gap:12px; }
    .sca-page-eyebrow { font-size:.58rem; }
    .sca-dashboard-head .sca-page-title { font-size:1.45rem; }
    .sca-kpi-grid { gap:9px; }
    .sca-kpi-card { padding:14px; border-radius:15px; }
    .sca-kpi-icon { width:34px; height:34px; flex-basis:34px; border-radius:10px; }
    .sca-kpi-label { font-size:.58rem; }
    .sca-kpi-value { font-size:1.4rem; }
    .sca-kpi-note { font-size:.62rem; }
    .sca-focus-card { flex-wrap:wrap; padding:15px; border-radius:17px; }
    .sca-focus-copy { flex:1 1 calc(100% - 64px); }
    .sca-focus-card .btn { width:100%; margin-left:0!important; margin-top:2px; }
    .sca-action-card { min-height:100px; padding:15px; }
    .sca-action-copy strong { font-size:.86rem; }
    .sca-action-copy small { font-size:.66rem; }
    .sca-info-strip { align-items:flex-start; }
    .sca-section-heading { margin-bottom:10px; }
    .content-wrapper form.card .card-body { padding:13px; }
    .content-wrapper .btn { min-height:41px; }
}
@media (max-width: 430px) {
    .sca-kpi-grid { grid-template-columns:1fr; }
    .sca-page-title { font-size:1.28rem!important; }
    .sca-kpi-value { font-size:1.55rem; }
}
@media (prefers-reduced-motion: reduce) {
    .sca-kpi-card,.sca-action-card { transition:none!important; }
}


/* Error screens */
.sca-error-screen { min-height:calc(100vh - 130px); display:grid; place-items:center; padding:28px 10px; }
.sca-error-card { width:min(100%,520px); padding:36px 30px; text-align:center; border:1px solid var(--sca-line); border-radius:24px; background:var(--sca-surface); box-shadow:0 18px 50px rgba(20,32,25,.08); }
.sca-error-icon { width:58px; height:58px; margin:0 auto 14px; display:grid; place-items:center; border-radius:17px; background:rgba(46,125,50,.09); color:var(--sca-green); font-size:1.35rem; }
.sca-error-code { margin-top:9px; color:var(--sca-text-strong); font-size:clamp(3.5rem,12vw,6rem); line-height:.9; font-weight:850; letter-spacing:-.07em; }
.sca-error-card h1 { margin:12px 0 7px; color:var(--sca-text-strong); font-size:1.15rem; font-weight:800; }
.sca-error-card p { max-width:40ch; margin:0 auto 21px; color:var(--sca-text-muted); font-size:.75rem; line-height:1.55; }
@media(max-width:575px){ .sca-error-screen{min-height:calc(100vh - 100px);padding:20px 4px}.sca-error-card{padding:28px 19px;border-radius:20px} }


/* Final product polish */
.nav-tabs { gap:4px; }
.nav-tabs .nav-link { border-radius:10px 10px 0 0; font-weight:650; padding:.68rem .9rem; }
.nav-pills .nav-link { border-radius:10px; font-weight:650; }
.list-group-item { border-color:var(--sca-line); }
.content-wrapper hr { border-color:var(--sca-line); }
.content-wrapper .card-header h2,
.content-wrapper .card-header h3,
.content-wrapper .card-header h4,
.content-wrapper .card-header h5,
.content-wrapper .card-header h6 { letter-spacing:-.01em; }
.content-wrapper .card-header i { margin-right:.25rem; }
@media(max-width:767px){
  .nav-tabs { overflow-x:auto; flex-wrap:nowrap; padding-bottom:1px; }
  .nav-tabs .nav-link { white-space:nowrap; font-size:.74rem; }
  .table-responsive { -webkit-overflow-scrolling:touch; }
}
